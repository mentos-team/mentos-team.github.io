---
/**
 * A MentOS session, set as text rather than shipped as a screenshot.
 *
 * The old website carried its boot screen as a 1.3 MB PNG. As markup it costs nothing,
 * scales to any width, is selectable and searchable, and reads correctly to a screen
 * reader.
 *
 * Everything shown here is taken from the source, not invented:
 *   - the prompt format is __prompt_print() in userspace/bin/shell.c:221
 *     ("user@host [HH:MM:SS] [cwd]", then "-> % " on the next line)
 *   - the hostname is filesystem/etc/hostname
 *   - the post-login message is filesystem/etc/motd
 *   - `ls /` lists the directories in filesystem/
 *   - the version comes from kernel/inc/version.h via site.ts
 *
 * Note what is NOT here: the green ASCII banner from the old screenshot. MentOS printed
 * it at version 0.3.0; today /etc/issue is empty and nothing draws it. Putting it back
 * would be showing visitors output the software does not produce.
 *
 * The colours are the brand's, not a faithful reproduction of an ANSI palette: this is
 * the one block on the site that paints with --brand-* directly, on the mark's own black
 * ground (see tokens.css). The real shell emits FG_GREEN, FG_CYAN and FG_BLUE_BRIGHT for
 * the three parts of the prompt, and this keeps that structure while using the mark's
 * green — so the console and the logo are the same green rather than two greens that
 * almost match. Contrast on the black ground is 8.32:1 for the green and 15.4:1 for the
 * cream, so the exception costs nothing in legibility and does not leak into the
 * interface, where the accent is a darkened, WCAG-checked version of the same hue.
 */
import { site } from '../data/site.ts';

interface Props {
  /** Accessible name for the block. */
  label?: string;
}

const { label = 'A MentOS terminal session' } = Astro.props;
const host = site.console.hostname;
---

<figure class="console" aria-label={label}>
  <div class="console__chrome" aria-hidden="true">
    <span class="console__dot console__dot--close"></span>
    <span class="console__dot console__dot--min"></span>
    <span class="console__dot console__dot--max"></span>
  </div>
  <pre class="console__screen"><code>{host} login: <span class="console__typed">root</span>
Password:
<span class="console__motd">{site.console.motd}</span>

<span class="console__user">root</span>@<span class="console__host">{host}</span> <span class="console__time">[09:14:22]</span> [/]
-&gt; % <span class="console__typed">uname -a</span>
{site.name} {site.console.version}

<span class="console__user">root</span>@<span class="console__host">{host}</span> <span class="console__time">[09:14:31]</span> [/]
-&gt; % <span class="console__typed">ls /</span>
bin  etc  home  root  usr

<span class="console__user">root</span>@<span class="console__host">{host}</span> <span class="console__time">[09:14:36]</span> [/]
-&gt; % <span class="console__cursor"></span></code></pre>
</figure>

<style>
  .console {
    /* The console supplies its own ground, so it is identical in both themes — a
       terminal does not get lighter because the page around it does. */
    background: var(--brand-ground);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .console__chrome {
    display: flex;
    gap: 0.4rem;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid color-mix(in oklab, var(--brand-cream) 12%, transparent);
  }

  .console__dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
  }

  /*
   * Decorative window furniture. These are the only warm colours anywhere on the site,
   * and they are inside a picture of a terminal rather than part of the interface.
   */
  .console__dot--close { background: #ff5f57; }
  .console__dot--min { background: #febc2e; }
  .console__dot--max { background: #28c840; }

  .console__screen {
    margin: 0;
    padding: var(--space-md);
    overflow-x: auto;
    font-family: var(--font-mono);
    /* Fluid, and small: this is a whole terminal and it has to fit a phone. */
    font-size: clamp(0.72rem, 1.5vw, 0.9rem);
    line-height: 1.5;
    color: var(--brand-cream);
    background: none;
  }

  /*
   * The prompt's own colours, matching the escape codes the shell emits: the user in
   * green, the host in cyan, the clock in bright blue.
   */
  .console__user { color: var(--brand-green); }
  .console__host { color: #4fd6d6; }
  .console__time { color: #7aa2f7; }

  .console__motd {
    color: color-mix(in oklab, var(--brand-cream) 75%, transparent);
  }

  /* What a person typed, as opposed to what the machine printed back. */
  .console__typed {
    color: #fff;
    font-weight: 500;
  }

  /*
   * A block, not a blinking one: an animated cursor beside running text is a
   * distraction, and prefers-reduced-motion would have to switch it off anyway.
   */
  .console__cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--brand-green);
  }
</style>
