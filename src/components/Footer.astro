---
/** Project footer: affiliation, licence, useful links. */
import { site } from '../data/site.ts';

const year = new Date().getUTCFullYear();
const org = site.organisation;
const licence = site.licence;
---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <p class="footer__name">{site.name}</p>
      <p class="footer__short">{site.expandedName}</p>
      <p><a href={org.departmentUrl}>{org.department}</a><br /><a href={org.universityUrl}>{org.university}</a></p>
    </div>
    <div>
      <h2 class="footer__heading">Project</h2>
      <ul class="footer__links">
        <li><a href={site.links.github}>Source repository</a></li>
        <li><a href={site.links.wiki}>Wiki</a></li>
        <li><a href={site.links.issues}>Issue tracker</a></li>
        <li><a href={site.links.downloads}>Course material downloads</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer__heading">This site</h2>
      <ul class="footer__links">
        <li><a href="/course-material/">Course material</a></li>
        <li><a href="/documentation/">Documentation</a></li>
        <li><a href="/team/">Team</a></li>
        <li><a href="/contacts/">Contacts</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer__heading">Address</h2>
      <address class="footer__address">
        {org.address.map((line) => <span>{line}</span>)}
        <a class="footer__map" href={org.mapUrl}>Map</a>
      </address>
    </div>
  </div>
  <div class="container footer__colophon">
    {/*
      Two copyright lines, not one. The old site printed a single "Copyright (c)
      2014-2022 MentOs-Team" that covered both the code and the website and was four
      years out of date. The licence line states the code's actual terms and points at
      the file that governs them; the year beside it is generated, so it cannot rot.
    */}
    <p class="meta">
      MentOS is free software under the <a href={licence.url}>{licence.name}</a> ·
      © {licence.since}–{year} {licence.holder}
    </p>
  </div>
</footer>

<style>
  /*
   * The footer is the last band: paper-2 closes the page, so the alternation reads all
   * the way down instead of the page fading out on the same white as its content.
   */
  .footer {
    background: var(--color-paper-2);
    border-top: 1px solid var(--color-rule-strong);
    padding-block: var(--space-xl) var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-lg) var(--space-xl);
  }

  .footer__name {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--color-ink);
  }

  .footer__short {
    font-size: var(--text-sm);
    color: var(--color-ink-3);
    margin-bottom: var(--space-xs);
  }

  .footer__heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin-bottom: var(--space-xs);
  }

  .footer__address {
    font-style: normal;
    display: grid;
  }

  .footer__map {
    margin-top: var(--space-xs);
    width: fit-content;
  }

  .footer__links {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .footer__colophon {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: var(--rule);
    display: grid;
    gap: var(--space-2xs);
  }
</style>
